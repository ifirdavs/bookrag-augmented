# Copy to .env and set both API keys. Never commit the populated .env.
ANTHROPIC_API_KEY=
FEDRESEARCH_GENERATION_MODEL=claude-haiku-5-5

# Atlas/Voyage embeddings and rerank-3 use this same model API key.
VOYAGE_API_KEY=
FEDRESEARCH_EMBEDDING_MODEL=voyage-4-large

# Optional nominal USD prices per million tokens; free credits are not applied.
# FEDRESEARCH_GENERATION_INPUT_PRICE=
# FEDRESEARCH_GENERATION_OUTPUT_PRICE=
# FEDRESEARCH_EMBEDDING_INPUT_PRICE=
# FEDRESEARCH_RERANKING_INPUT_PRICE=
